# API Key for GROQ API LLM
GROQ_API_KEY=your_groq_api_key_here

# API Key for Voyage AI embeddings
VOYAGEAI_API_KEY=your_voyage_ai_api_key_here

# MongoDB Credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here

# MongoDB Database Name
MONGO_DB_NAME=your_database_name_here

# MongoDB Connection URI
MONGO_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@mongodb27017/?authSource=admin

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT Secret Key
SECRET_KEY=your_secret_key